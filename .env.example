# Local development only. Never use these values in production.
LIBRAAI_ENV=development
LIBRAAI_DEBUG=1
SECRET_KEY=REPLACE_WITH_A_RANDOM_LOCAL_DEVELOPMENT_SECRET
LIBRAAI_SESSION_BACKEND=sqlite
LIBRAAI_DB_PATH=libra.db
SSLCOMMERZ_SANDBOX=true
BKASH_SANDBOX=true
LIBRAAI_LIVE_PAYMENT_E2E_VERIFIED=no
LIBRAAI_LICENSE_RIGHTS_VERIFIED=no
LIBRAAI_SECURITY_REVIEW_PASSED=no
LIBRAAI_BACKUP_RESTORE_VERIFIED=no
