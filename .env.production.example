# Copy to .env and replace every placeholder before deployment.
LIBRAAI_ENV=production
LIBRAAI_DEBUG=0
SECRET_KEY=REPLACE_WITH_A_LONG_RANDOM_PRODUCTION_SECRET
LIBRAAI_PUBLIC_URL=https://your-domain.example
LIBRAAI_SESSION_BACKEND=sqlite
LIBRAAI_DB_PATH=/data/libraai.db
SSLCOMMERZ_SANDBOX=true
BKASH_SANDBOX=true
LIBRAAI_LIVE_PAYMENT_E2E_VERIFIED=no
LIBRAAI_LICENSE_RIGHTS_VERIFIED=no
LIBRAAI_SECURITY_REVIEW_PASSED=no
LIBRAAI_BACKUP_RESTORE_VERIFIED=no

# Library borrowing policy
LIBRAAI_LIBRARY_TIMEZONE=Asia/Dhaka
LIBRAAI_FINE_PER_DAY_PAISE=1000
LIBRAAI_TRUSTED_HOSTS=your-domain.example,www.your-domain.example
